\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The fixed $(3,4,\infty )$ base data. The arrows denote the restriction of $f$ to each indicated fibre, with its scheme multiplicity retained. The ordinary period quotient, finite affine quotients and the paired hexagon are the three actual local models in the common conventions; their overlap maps are fixed there.}}{85}{figure.2}\protected@file@percent }
\newlabel{fig:I:orbifold}{{2}{85}{The fixed $(3,4,\infty )$ base data. The arrows denote the restriction of $f$ to each indicated fibre, with its scheme multiplicity retained. The ordinary period quotient, finite affine quotients and the paired hexagon are the three actual local models in the common conventions; their overlap maps are fixed there}{figure.2}{}}
