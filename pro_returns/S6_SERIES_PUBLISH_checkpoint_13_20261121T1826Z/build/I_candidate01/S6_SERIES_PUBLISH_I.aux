\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The exact parameter disc for the standard fixed data. The coordinate map is $w=e^{-\pi i c}$ and the coarser coordinate map is $u=w^2$. The imaginary diameter is the fixed locus of $w\DOTSB \mapstochar \rightarrow -\bar  w$, which is the reflected-family map. The two boundary obstructions use the meridian comparison at the puncture and the intrinsic Albanese nome at the outer circle. The special fibres are over $t=0,1,\infty $ in every member, as indicated in Figure~\ref {fig:I:orbifold}.}}{85}{figure.3}\protected@file@percent }
\newlabel{fig:I:parameter-disc}{{3}{85}{The exact parameter disc for the standard fixed data. The coordinate map is $w=e^{-\pi i c}$ and the coarser coordinate map is $u=w^2$. The imaginary diameter is the fixed locus of $w\mapsto -\bar w$, which is the reflected-family map. The two boundary obstructions use the meridian comparison at the puncture and the intrinsic Albanese nome at the outer circle. The special fibres are over $t=0,1,\infty $ in every member, as indicated in Figure~\ref {fig:I:orbifold}}{figure.3}{}}
\newlabel{fig:I:parameter-disc@cref}{{[figure][3][]3}{[1][85][]85}{}{}{}}
