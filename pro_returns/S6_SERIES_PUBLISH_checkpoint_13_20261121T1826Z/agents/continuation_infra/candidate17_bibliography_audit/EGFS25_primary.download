<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex70.m2" class="ltx_Math" alttext="\displaystyle=\cdots+z^{-7}u^{12}+z^{-4}u^{5}+z^{-1}u^{1}+z^{2}u^{0}+z^{5}u^{2}+z^{8}u^{7}+z^{11}u^{15}+\cdots" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">⋯</mo><mo>+</mo><mrow><msup><mi>z</mi><mrow><mo>−</mo><mn>7</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>12</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>5</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>1</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>0</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>5</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>7</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>11</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>15</mn></msup></mrow><mo>+</mo><mo lspace="0em">⋯</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\cdots+z^{-7}u^{12}+z^{-4}u^{5}+z^{-1}u^{1}+z^{2}u^{0}+z^{5}u^{2}+z^{8}u^{7}+z^{11}u^{15}+\cdots</annotation></semantics></math></td>
