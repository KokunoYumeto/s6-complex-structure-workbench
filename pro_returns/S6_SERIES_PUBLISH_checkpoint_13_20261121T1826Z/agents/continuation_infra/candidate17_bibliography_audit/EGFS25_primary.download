<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex65.m2" class="ltx_Math" alttext="\displaystyle=\cdots+z^{-3}u^{6}+z^{-2}u^{3}+z^{-1}u^{1}+z^{0}u^{0}+z^{1}u^{0}+z^{2}u^{1}+z^{3}u^{3}+\cdots" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">⋯</mo><mo>+</mo><mrow><msup><mi>z</mi><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>6</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>1</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>0</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>0</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>1</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>3</mn></msup></mrow><mo>+</mo><mo lspace="0em">⋯</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\cdots+z^{-3}u^{6}+z^{-2}u^{3}+z^{-1}u^{1}+z^{0}u^{0}+z^{1}u^{0}+z^{2}u^{1}+z^{3}u^{3}+\cdots</annotation></semantics></math></td>
