1: #!/usr/bin/env python3
2: """Export the complete audited infinity comparison as the separate P3K.57 include."""
3: from pathlib import Path
4: from datetime import datetime, timezone
5: import json,re
6: 
7: ROOT=Path(__file__).resolve().parents[2]
8: sources=['notes/part3_source_infinity_fourfold_working.md',
9:          'notes/part3_source_infinity_excision_working.md']
10: with (ROOT/'records/literature_fourfold.md').open('a') as log:
11:     log.write('\n- '+datetime.now(timezone.utc).isoformat()+
12:       ' — Opened '+', '.join(sources)+
13:       ' and own results_mapping.json. Reason: complete P3K.57 manuscript export. '
14:       'Material: all source/Cartier/cap maps, exact regular fan and local quotient proof, '
15:       'relative circle-quotient bordism, signed finite-chart residues and actual Hopf-lift transfer.\n')
16: IF=(ROOT/sources[0]).read_text().split('## IF.1.',1)[1]
17: IF='## IF.1.'+IF
18: IE=(ROOT/sources[1]).read_text().split('## IE.1.',1)[1]
19: IE='## IE.1.'+IE
20: 
21: # Preserve all history in the working sources; the manuscript follows the completed proof.
22: IF=IF.replace('An earlier proposed \\(\\epsilon^4\\) change counted only the \\(U_a\\) factor.\n'
23:   'Equation (IF.6) locates its omitted \\(q\\) factor and (IF.7) corrects that\n'
24:   'attempt. No scalar convention is changed.','')
25: IF=IF.replace('## IF.7. Remaining attachment and executed scope','## IF.7. The actual origin and the attachment sequence')
26: IF=IF.replace('This removes that particular local annular-deck mismatch. It does not\n'
27:   'construct a compact global bordism: the rank-one faces of (IF.16) need\n'
28:   'their actual quotient atlas, the finite-cap attachment must be written,\n'
29:   'and the separate selected I1 scalar trace must be joined with its physical\n'
30:   'Euler line and oriented boundary. Fixed \\(\\lambda\\) is not asserted to\n'
31:   'give uniform contraction through \\(\\epsilon=0\\).',
32:   'The following sections construct the rank-one quotient atlas, its actual finite-cap\n'
33:   'attachment, and the real selected-cusp comparison, retaining the physical Euler line\n'
34:   'and oriented boundary. The analytic collision filling uses the specified positive\n'
35:   'scalar rescaling; IE.6 removes that scalar winding by an actual parameter bordism.')
36: IF=re.sub(r'Audit correction, 2026-11-17 after checkpoint14:[\s\S]*?the smaller fan computations supply arithmetic only\.\n',
37:   r'The raw multiplier order \\(N-2\\) must be combined with the actual nodal-line metric and source reindexing. The complete operator bounds below retain losses three and four, respectively, and the geometric proof uses the safe orders \\(N=8\\) and \\(N=6\\).\n', IF, count=1)
38: IF=IF.replace('## IF.9. Exact face kernels and the remaining real attachment','## IF.9. Exact face kernels and the analytic quotient')
39: IF=IF.replace('To complete the source return one still needs a real bordism\n'
40:   'joining this collision/cap partial filling to the actual selected\n'
41:   'I1 scalar trace, with its physical Euler line and normal\n'
42:   'orientation. No full holomorphic selected corner, compact global\n'
43:   'fourfold, signature, or return value is asserted in this note.',
44:   'The real joining of this partial filling to the selected scalar trace is\n'
45:   'constructed in IE.1--6, with its physical Euler line and normal orientation.')
46: IF=IF.replace('This is the partial attachment used in the next step. It provides\n'
47:   'no filling of that last boundary and no return invariant. The exact\n'
48:   'remaining morphism is its gluing to the selected-cusp scalar trace\n'
49:   'with the physical Euler line and its normal orientation.',
50:   'This partial attachment supplies the exact source-base boundary used in\n'
51:   'IE.1--6. Those sections construct its real comparison with the selected\n'
52:   'scalar trace, with the physical Euler line and its normal orientation.')
53: IF=IF.replace('of\nRCZ.5,','of\nP3K.49, RCZ.5,').replace('of RCZ.4','of P3K.49, RCZ.4')
54: 
55: statement=r'''For the marked source
56: \[
57:  y^2=x^3+(-2+3\epsilon^2)x^2+t x
58:        +\epsilon^2(1-\epsilon^2)^2,\qquad
59:  G=(0,\epsilon(1-\epsilon^2)),
60: \]
61: retain the selected whole-zero fibre at
62: \(t_*=(1-\epsilon^2)(1-3\epsilon^2)\), the actual Cartier line
63: \(M_a=\mathcal O([aG]-[O])\), and the suspension over \(-bG\),
64: where \(ab=2\). Use either the initial vertical-edge cusp fan or its
65: literal reflected fan, and the admitted cap data
66: \[
67:  \begin{array}{c|c|c}
68:  (a,b)&\text{cap order}&\text{root type}\\ \hline
69:  (1,2)&m=4p&\text{good III-star root}\\
70:  (2,1)&m=4p-1&\text{reduced III root}
71:  \end{array}\qquad(p\ge1),
72: \]
73: with either norm sign \(n=\pm1\) and every retained integral
74: \(d\delta\) twist. These are the completed sphere families of
75: P3F.41 and P3K.24, with their prescribed source, line and cap maps.
76: For a fixed sufficiently small nonzero suspension scalar, the actual
77: positive \(\epsilon\)-loop has Jin characteristic integer and oriented
78: clutched-sphere class
79: \[
80:  \begin{array}{c|c|c}
81:  (a,b)&\displaystyle\int\frac{4x^3-p_1x}{24}
82:        &\Theta_7\simeq\mathbb Z/28\\ \hline
83:  (1,2)&0&0\\
84:  (2,1)&1&1.
85:  \end{array}
86: \]
87: The actual source/Cartier/cap morphism under
88: \(v=\epsilon^{-2}-1\) preserves the suspension scalar and retains
89: the full \(D^{-4}\) root endpoint, the reduced doubled lattice period,
90: the annular reference overlap and the quadratic scalar cochain.
91: The theorem assigns no source-zero return and makes no further fan comparison.'''
92: 
93: body=IF+'\n\n'+IE
94: body=body.replace('Atiyah--Bott (1984), printed pages 8--9,\n'
95:   'Theorem (3.5), equations (3.7)--(3.8).',
96:   r'Atiyah--Bott \cite[pp.~8--9, Theorem~(3.5), equations~(3.7)--(3.8)]{AtiyahBott1984}.')
97: 
98: def tex(value):
99:     for prefix in ('IF','IE'):
100:         value=value.replace('\\tag{'+prefix+'.','\\tag{P3K.57.'+prefix+'.')
101:         value=value.replace('('+prefix+'.','(P3K.57.'+prefix+'.')
102:     value=value.replace(')--(P3K.57.',')--\\allowbreak (P3K.57.')
103:     value=re.sub(r'^### (.+)$',lambda m:r'\par\smallskip\noindent\textit{'+m.group(1)+r'.}\enspace',value,flags=re.M)
104:     value=re.sub(r'^## (.+)$',lambda m:r'\par\medskip\noindent\textbf{'+m.group(1)+r'.}\enspace',value,flags=re.M)
105:     value=re.sub(r'`([^`]+)`',lambda m:r'\path{'+m.group(1)+'}',value)
106:     value=re.sub(r'\*\*([^*]+)\*\*',lambda m:r'\textbf{'+m.group(1)+'}',value)
107:     return value.strip()+'\n'
108: 
109: export=(r'\begin{statement}{P3K.57}{Proved}'+'\n'+tex(statement)+
110:         r'\end{statement}'+'\n'+r'\begin{proof}'+'\n'+tex(body)+r'\end{proof}'+'\n')
111: assert re.search(r'(?<!\\)#',export) is None
112: assert '`' not in export
113: assert '\\tag{SZ.' not in export and '(SZ.' not in export
114: assert 'K39' not in export
115: (ROOT/'notes/part3_source_infinity_return.tex').write_text(export)
116: (ROOT/'notes/part3_source_infinity_return.md').write_text(
117:     '# P3K.57. Proved: the actual marked infinity return\n\n'+statement+
118:     '\n\n**Proof.**\n\n'+body+'\n\n**End of proof.**\n')
119: mapping_path=ROOT/'code/part3_fourfold/results_mapping.json'
120: mapping=json.loads(mapping_path.read_text())
121: mapping['results']=[r for r in mapping['results'] if r.get('id')!='P3K.57']
122: mapping['results'].append(dict(id='P3K.57',status='Proved',item_of_prompt='3.4',
123:  statement='Actual fixed-scalar positive epsilon infinity return is 0 for the good III-star branch and 1 for the reduced III branch, in each initial/reflected vertical-edge fan.',
124:  proof_file='notes/part3_source_infinity_return.md',latex_file='notes/part3_source_infinity_return.tex',
125:  working_proofs=sources,parameter='positive epsilon loop, fixed sufficiently small scalar; v=epsilon^-2-1',
126:  branches=[{'a':1,'b':2,'m':'4p','Jin_integer':0,'Theta7':0},
127:            {'a':2,'b':1,'m':'4p-1','Jin_integer':1,'Theta7':1}],
128:  signs=[-1,1],delta_twist='arbitrary retained integer d',
129:  fan_scope='initial vertical-edge fan and its literal reflected fan',
130:  executed_geometric_orders=[[1,2,8],[2,1,6]],
131:  exact_certificates=['code/part3_fourfold/source_infinity_exact.json',
132:    'code/part3_fourfold/source_infinity_excision_certificate.json',
133:    'code/part3_fourfold/source_infinity_regular_fan_1_2_8.json',
134:    'code/part3_fourfold/source_infinity_regular_fan_2_1_6.json'],
135:  audit='Root complete maps/normal classes/Stokes/orientation/transfer/local fan/localization PASS, including the corrected nodal metric bound and safe geometric orders in IF.28b.',
136:  remaining_scope='No source-zero value or further fan comparison is assigned.'))
137: mapping_path.write_text(json.dumps(mapping,indent=2)+'\n')
138: print('Exported complete P3K.57 with IF.1--12, IF.5a/8a, IE.1--7 and actual return transfer.')
