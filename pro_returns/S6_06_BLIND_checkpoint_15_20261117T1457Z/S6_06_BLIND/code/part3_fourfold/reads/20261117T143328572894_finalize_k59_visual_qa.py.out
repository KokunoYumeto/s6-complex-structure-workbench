1: #!/usr/bin/env python3
2: """Record full-size direct visual review of the five K59 proof pages."""
3: from pathlib import Path
4: from datetime import datetime,timezone
5: import hashlib,json
6: ROOT=Path(__file__).resolve().parents[2]
7: p=ROOT/'records/qa_k59.json';r=json.loads(p.read_text())
8: assert r['compile']=='PASS' and r['pages']==5 and not r['overflows_pt']
9: assert not r['boundary_issues'] and not r['missing_character'] and not r['undefined_reference']
10: r.update(visual_review='PASS',visual_review_utc=datetime.now(timezone.utc).isoformat(),reviewer='fourfold',
11:  page_count_reviewed=5,full_size_pages=[1,2,3,4,5],
12:  findings=['All five final pages directly reviewed at full size.',
13:  'The initially overlong CF.13 display was split into three aligned rows; the final build has zero overfull boxes.',
14:  'No clipping, equation collision, malformed matrix, missing symbol, orphan heading, or bad page boundary found.',
15:  'The complete all-j statement, explicit CF.6a unitary path and proved-P0-only diagnostic scope are present.'],
16:  pdf_sha256=hashlib.sha256((ROOT/'code/part3_fourfold/k59_standalone.pdf').read_bytes()).hexdigest(),
17:  source_sha256=hashlib.sha256((ROOT/'notes/part3_source_cusp_mutation_staircase_working.md').read_bytes()).hexdigest(),
18:  peer_certificate='code/part3_fourfold/source_cusp_mutation_peer_certificate.json')
19: p.write_text(json.dumps(r,indent=2)+'\n')
20: (ROOT/'records/k59_standalone_visual_qa.json').write_text(json.dumps(r,indent=2)+'\n')
21: print(json.dumps({k:r[k] for k in ['visual_review','pages','overflows_pt','pdf_sha256','source_sha256']},indent=2))
