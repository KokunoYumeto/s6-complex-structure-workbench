1: #!/usr/bin/env python3
2: """Compare the already reviewed pages across the sole heading-break repair."""
3: from pathlib import Path
4: from datetime import datetime,timezone
5: import hashlib,json,fitz
6: ROOT=Path(__file__).resolve().parents[2]
7: before=ROOT/'code/part3_fourfold/attempts/k57_20261117T141001/k57_standalone.pdf'
8: after=ROOT/'code/part3_fourfold/k57_standalone.pdf'
9: with (ROOT/'records/literature_fourfold.md').open('a') as log:
10:  log.write('\n- '+datetime.now(timezone.utc).isoformat()+' — Opened the archived and final K57 standalone PDFs. Reason: identify exact raster changes after keeping IE.2 with its first paragraph; material: page raster equality and changed-page list.\n')
11: old=fitz.open(before);new=fitz.open(after)
12: assert len(old)==len(new)==22
13: same=[];changed=[]
14: for i in range(len(new)):
15:  a=old[i].get_pixmap(matrix=fitz.Matrix(1.5,1.5),alpha=False).samples
16:  b=new[i].get_pixmap(matrix=fitz.Matrix(1.5,1.5),alpha=False).samples
17:  (same if hashlib.sha256(a).digest()==hashlib.sha256(b).digest() else changed).append(i+1)
18: result=dict(utc=datetime.now(timezone.utc).isoformat(),same_pages=same,changed_pages=changed,
19:  first_review='All22 pages inspected through six contact sheets before the heading-break repair.',
20:  final_full_size_review=[1,8,13,15,16,19,22])
21: (ROOT/'records/k57_final_layout_compare.json').write_text(json.dumps(result,indent=2)+'\n')
22: print(json.dumps(result,indent=2))
