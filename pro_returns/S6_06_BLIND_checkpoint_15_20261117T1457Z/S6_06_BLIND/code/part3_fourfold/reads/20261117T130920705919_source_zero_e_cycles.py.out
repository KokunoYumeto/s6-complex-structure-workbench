1: #!/usr/bin/env python3
2: """Exact central cycles of the local E fixed surfaces.
3: 
4: The actual v=0 Tate identity Q*P^2=1 trivializes the determinant
5: normal line by Z^a*V^2 on the punctured source annulus.  The
6: calculation uses that explicit relative marking.  It does not
7: identify this E atlas with the cap atlas.
8: """
9: from pathlib import Path
10: from datetime import datetime,timezone
11: from fractions import Fraction as Q
12: from math import gcd
13: import json,gc
14: ROOT=Path(__file__).resolve().parents[2]
15: 
16: def quad(v,I):
17:  return sum(v[i]*I[i][j]*v[j] for i in range(len(v)) for j in range(len(v)))
18: def det(v,w):return v[0]*w[1]-w[0]*v[1]
19: 
20: def one(a,b,N):
21:  src=ROOT/'code/part3_fourfold'/f'source_zero_fixed_charts_{a}_{b}_{N}.json'
22:  with (ROOT/'records/literature_fourfold.md').open('a') as f:
23:   f.write('\n- '+datetime.now(timezone.utc).isoformat()+' — Opened '
24:     +str(src.relative_to(ROOT))+'. Reason: exact central E-cycle intersection '
25:     'and relative determinant-normal calculation. Material: actual rays, '
26:     'face periods and physical normal labels; no cap attachment inferred.\n')
27:  data=json.loads(src.read_text())
28:  charts={c['id']:c for c in data['charts']}
29:  comps=[c for c in data['components'] if c['boundary_tag']=='E']
30:  rows=[];total=Q(0);checks=0
31:  for c in comps:
32:   v=c['canonical_vectors']
33:   assert len(v)==2 and all(t[0]==0 and t[2:]==[1,0] for t in v)
34:   j=min(t[1] for t in v)
35:   assert sorted(t[1] for t in v)==[j,j+1]
36:   rays={}
37:   for name in c['charts']:
38:    ch=charts[name];assert ch['sector']=='E'
39:    n1,n2=ch['period_from_canonical']
40:    for col in ch['zero_weight_columns']:
41:     Z,V,r,s=[ch['matrix'][i][col] for i in range(4)]
42:     Z-=s*(2*n1+b*n2)
43:     V-=r*N*n2+s*(-a*n1+(N-1)*n2)
44:     assert s>0 and gcd(Z,s)==1
45:     l=Z//(2*s)
46:     Z-=2*l*s;V+=a*l*s
47:     db=(2*j+1)*r-2*V-a*Z
48:     key=(Z,s)
49:     val={'ray':[Z,s],'ambient_unwrapped':[Z,V,r,s],
50:          'determinant_normal_divisor':db}
51:     if key in rays:assert rays[key]['determinant_normal_divisor']==db
52:     else:rays[key]=val
53:     checks+=3
54:   ordered=sorted(rays.values(),key=lambda t:Q(t['ray'][0],t['ray'][1]))
55:   R=len(ordered);assert R>=2
56:   I=[[0]*R for _ in range(R)]
57:   for i in range(R):
58:    prev=ordered[(i-1)%R]['ray'][:]
59:    cur=ordered[i]['ray']
60:    nxt=ordered[(i+1)%R]['ray'][:]
61:    if i==0:prev[0]-=2*prev[1]
62:    if i==R-1:nxt[0]+=2*nxt[1]
63:    assert det(prev,cur)==-1 and det(cur,nxt)==-1
64:    I[i][i]=det(prev,nxt)
65:    I[i][(i-1)%R]+=1;I[i][(i+1)%R]+=1
66:    checks+=2
67:   mult=[t['ray'][1] for t in ordered]
68:   assert all(sum(I[i][j]*mult[j] for j in range(R))==0 for i in range(R))
69:   K=[s-1 for s in mult]
70:   D=[t['determinant_normal_divisor'] for t in ordered]
71:   K2=quad(K,I);D2=quad(D,I)
72:   assert K2==-(R-2)
73:   p1=K2-2*R
74:   res=Q(p1-3*D2,24)
75:   total+=res
76:   rows.append({'id':c['id'],'chain_index':j,'curve_count':R,
77:     'curves':ordered,'intersection_matrix':I,'fibre_multiplicities':mult,
78:     'canonical_divisor':K,'canonical_square':K2,
79:     'determinant_normal_divisor':D,'determinant_normal_square':D2,
80:     'relative_euler':R,'relative_p1':p1,
81:     'relative_normal_link_residue':str(res)})
82:   checks+=R+3
83:  summary={'utc':datetime.now(timezone.utc).isoformat(),
84:   'parameters':{'a':a,'b':b,'N':N},
85:   'status':'PASS: actual local E cycles, intersections and explicit relative normal marking',
86:   'checks':checks,'component_count':len(rows),
87:   'relative_E_residue':str(total),
88:   'scope':'Local E annular marking by dlog(Z) wedge dT and Z^a V^2. '
89:     'The cap component permutation and global boundary orientation are not identified.'}
90:  stem=ROOT/'code/part3_fourfold'/f'source_zero_e_cycles_{a}_{b}_{N}'
91:  Path(str(stem)+'.json').write_text(json.dumps({'summary':summary,'components':rows},
92:   separators=(',',':'))+'\n')
93:  Path(str(stem)+'_summary.json').write_text(json.dumps(summary,indent=2)+'\n')
94:  print(json.dumps(summary,indent=2),flush=True)
95:  del data,charts
96:  gc.collect()
97: if __name__=='__main__':
98:  for case in ((2,1,6),(1,2,8)):one(*case)
