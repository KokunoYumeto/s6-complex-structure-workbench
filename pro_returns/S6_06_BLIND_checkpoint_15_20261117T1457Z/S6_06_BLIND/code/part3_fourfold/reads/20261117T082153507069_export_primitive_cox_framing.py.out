1: #!/usr/bin/env python3
2: """Export the full reviewed K27 comparison and its rotating clutch."""
3: from pathlib import Path
4: from datetime import datetime, timezone
5: import json
6: import re
7: 
8: ROOT=Path(__file__).resolve().parents[2]
9: def read(rel, reason):
10:     with (ROOT/"records/literature_fourfold.md").open("a") as log:
11:         log.write("\n- "+datetime.now(timezone.utc).isoformat()
12:                   +" — Opened own "+rel+"; reason: "+reason
13:                   +"; material: complete reviewed K27 normal comparison and actual degree-one clutch.\n")
14:     return (ROOT/rel).read_text()
15: 
16: rel="notes/part3_primitive_cox_framing.md"
17: source=read(rel,"export the independently root-audited proof separately")
18: rotating=read("notes/part3_primitive_rotating_integers.md",
19:               "include the full actual rotating-frame calculation rather than cite it")
20: clutch=rotating.split("## The actual frame comparison\n",1)[1].split(
21:     "## Characteristic numbers in this framing",1)[0].strip()
22: source=source.replace(
23:     "# P3K.27. Primitive scalar families: rotating/Cox normal comparison submitted for audit",
24:     "# P3K.27. Proved: primitive scalar families and their actual rotating Cox normal framing"
25: )
26: source=source.replace(
27:     "This draft identifies the normal product used in the K22 rotating\n"
28:     "calculation with the actual cusp product used in the K23 fixed-edge\n"
29:     "comparison. It retains the real orbit extension of the radial\n"
30:     "\\(|q|^\\theta\\) factor through the node. The statement is not yet\n"
31:     "exported to the manuscript.\n\n",
32:     ""
33: )
34: old=("The full degree-one normal-clutch calculation, saved in\n"
35:      "notes/part3_primitive_rotating_integers.md, gives\n"
36:      "\\(p_1(\\bar\\nu)=0\\). The actual K22 page has\n")
37: new=("We include the complete degree-one normal-clutch calculation "
38:      "in the actual matched framing.\n\n"+clutch+"\n\n"
39:      "The actual K22 page has\n")
40: if old in source:
41:     source=source.replace(old,new)
42: else:
43:     assert "We include the complete degree-one normal-clutch calculation" in source
44: source=source.replace("This proves the proposed\n","This proves the\n")
45: source=source.split("## Audit boundary",1)[0].split("## Audit record",1)[0]
46: source+=(
47:     "\n## Audit record\n\n"
48:     "Root independently checked the exact origins, representative-cell "
49:     "closing, annular transition, positive node product, quaternion "
50:     "overlap, physical Hopf orientation, and complete rotating clutch. "
51:     "Checks independently verified the same actual family comparison and "
52:     "the literal bounded unitary identity q_H to A q_H B. "
53:     "The root audit passed before export. The exact symbolic certificate "
54:     "is code/part3_fourfold/primitive_cox_framing.py and its JSON output; "
55:     "the degree-one clutch is also independently executed in "
56:     "code/part3_fourfold/primitive_normal_clutch.py.\n"
57: )
58: (ROOT/rel).write_text(source)
59: 
60: body=source.split("\n",1)[1]
61: statement,proof=body.split("## 1. The actual two products and their literal transition",1)
62: proof="## 1. The actual two products and their literal transition\n"+proof
63: proof,audit=proof.split("## Audit record",1)
64: def tex(text):
65:     text=re.sub(r"(?m)^## (.+)$",
66:                 lambda m:r"\par\medskip\noindent\textbf{"+m.group(1)+r".}\enspace",
67:                 text)
68:     text=re.sub(r"(?m)^# (.+)$",lambda m:r"\subsection{"+m.group(1)+"}",text)
69:     tick=chr(96)
70:     text=re.sub(tick+"([^"+tick+"]+)"+tick,
71:                 lambda m:r"\path{"+m.group(1)+"}",text)
72:     text=re.sub(r"(?<![A-Za-z{])(?:notes|code)/[A-Za-z0-9_./-]+",
73:                 lambda m:r"\path{"+m.group(0)+"}",text)
74:     return text.strip()+"\n"
75: output=(
76:     r"\begin{statement}{P3K.27}{Proved}"+"\n"+tex(statement)
77:     +r"\end{statement}"+"\n"
78:     +r"\begin{proof}"+"\n"+tex(proof)+r"\end{proof}"+"\n"
79:     +r"\par\medskip\noindent\textbf{Audit record.}\enspace"+"\n"+tex(audit)
80: )
81: assert "#" not in output and "submitted" not in output.lower()
82: (ROOT/"notes/part3_primitive_cox_framing.tex").write_text(output)
83: 
84: mapping=json.loads(read("code/part3_fourfold/results_mapping.json",
85:                         "append the K27 actual framing result without changing prior rows"))
86: mapping["results"]=[row for row in mapping["results"] if row.get("id")!="P3K.27"]
87: mapping["results"].append({
88:     "id":"P3K.27","status":"Proved","item_of_prompt":"3.4",
89:     "statement":"The actual K22 cusp Cox product and rotating framing have zero free normal-gauge difference; k=-3d, ell=-24 and relative coordinates (6,3d-6,1-d/2).",
90:     "proof_file":rel,
91:     "latex_file":"notes/part3_primitive_cox_framing.tex",
92:     "code":"code/part3_fourfold/primitive_cox_framing.py",
93:     "output":"code/part3_fourfold/primitive_cox_framing.json",
94:     "rotating_clutch_code":"code/part3_fourfold/primitive_normal_clutch.py",
95:     "denominators":[8,14,20,30],
96:     "k":[-24,-42,-60,-90],"ell":[-24,-24,-24,-24],
97:     "relative_m":[6,6,6,6],"relative_n":[18,36,54,84],
98:     "central_classes_mod_28":[25,22,19,14],
99:     "retained_limit":"The actual relative four-cycle of a different finite-isotropy edge remains unassigned.",
100:     "audit":"Root checked the full marked normal comparison before export."
101: })
102: (ROOT/"code/part3_fourfold/results_mapping.json").write_text(json.dumps(mapping,indent=2)+"\n")
103: print("Exported complete root-audited P3K.27 separately, including the full degree-one clutch calculation.")
