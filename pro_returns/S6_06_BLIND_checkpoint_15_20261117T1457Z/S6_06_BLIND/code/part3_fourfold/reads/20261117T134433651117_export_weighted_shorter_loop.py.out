1: #!/usr/bin/env python3
2: """Export fully audited weighted endpoint descent as separate P3K.35."""
3: from pathlib import Path
4: from datetime import datetime, timezone
5: import json,re
6: 
7: ROOT=Path(__file__).resolve().parents[2]
8: rel='notes/part3_weighted_shorter_loop.md'
9: with (ROOT/'records/literature_fourfold.md').open('a') as log:
10:     log.write('\n- '+datetime.now(timezone.utc).isoformat()+' — Opened own '+rel+
11:               ', results_mapping.json and qa_original_cox_descent.py. Reason: export fully audited P3K.35 and its standalone QA. '
12:               'Material: root/checks full-proof PASS, blind root-character PASS, exact global rational lift and all thirty integer polynomial checks.\n')
13: source=(ROOT/rel).read_text()
14: statement=source.split('## 1. Scope and the actual map',1)[1].split('## 2.',1)[0]
15: body='## 2.'+source.split('## 2.',1)[1]
16: 
17: def tex(value):
18:     value=value.replace(r'\tag{WS.',r'\tag{P3K.35.').replace('(WS.','(P3K.35.')
19:     value=re.sub(r'^### (.+)$',lambda m:r'\par\smallskip\noindent\textit{'+m.group(1)+r'.}\enspace',value,flags=re.M)
20:     value=re.sub(r'^## (.+)$',lambda m:r'\par\medskip\noindent\textbf{'+m.group(1)+r'.}\enspace',value,flags=re.M)
21:     value=re.sub(r'`([^`]+)`',lambda m:r'\path{'+m.group(1)+'}',value)
22:     lines=value.splitlines();out=[];i=0
23:     while i<len(lines):
24:         if lines[i].startswith('|'):
25:             rows=[]
26:             while i<len(lines) and lines[i].startswith('|'):
27:                 cells=[x.strip() for x in lines[i].strip('|').split('|')]
28:                 if not all(re.fullmatch(r'[: -]+',x or '-') for x in cells):
29:                     cells=[x.replace('z_i',r'\(z_i\)') for x in cells]
30:                     rows.append(cells)
31:                 i+=1
32:             out.append(r'\begin{center}\small\begin{tabular}{p{0.32\linewidth}p{0.04\linewidth}p{0.22\linewidth}p{0.27\linewidth}}\toprule')
33:             for j,cells in enumerate(rows):
34:                 out.append(' & '.join(cells)+r'\\')
35:                 if j==0:out.append(r'\midrule')
36:             out.append(r'\bottomrule\end{tabular}\end{center}')
37:             continue
38:         out.append(lines[i]);i+=1
39:     value='\n'.join(out)
40:     pattern=r'\\\[\n( T\(E,k,z\)=\\begin\{pmatrix\}[\s\S]*?\\end\{pmatrix\}\.)\n\\\]'
41:     value=re.sub(pattern,lambda m:'\\[\n\\resizebox{\\linewidth}{!}{$\\displaystyle\n'+m.group(1)+'\n$}\n\\]',value,count=1)
42:     return value.strip()+'\n'
43: 
44: out=(r'\begin{statement}{P3K.35}{Proved}'+'\n'+tex(statement)+r'\end{statement}'+'\n'+
45:      r'\begin{proof}'+'\n'+tex(body)+r'\end{proof}'+'\n')
46: assert '#' not in out and '`' not in out
47: (ROOT/'notes/part3_weighted_shorter_loop.tex').write_text(out)
48: mapping=json.loads((ROOT/'code/part3_fourfold/results_mapping.json').read_text())
49: mapping['results']=[r for r in mapping['results'] if r.get('id')!='P3K.35']
50: mapping['results'].append(dict(id='P3K.35',status='Proved',item_of_prompt='3.4',
51:     statement='All thirty fixed-source whole-I1 branches descend by an actual cyclic endpoint to w=r^b, lambda=w^(M/b), with simultaneous Cox product and integer pair (-3H/b,-24chi/b).',
52:     proof_file=rel,latex_file='notes/part3_weighted_shorter_loop.tex',
53:     code='code/part3_fourfold/weighted_shorter_loop.py',output='code/part3_fourfold/weighted_shorter_loop.json',
54:     parameter='w=r^b; lambda=w^(M/b)',k='-3H/b',ell='-24chi/b',A='(chi-H/2)/b',
55:     all_fan='A_w+ell_w*(S-1)/8-k_w*(S^2-1)/8 modulo28',
56:     branch_count=30,sphere_signs=[-1,1],order_one_data='Every fixed order-one norm and the actual framing-chart norm -b0 are retained.',
57:     audit='Root and checks full-proof PASS; blind independent actual root-character PASS.',
58:     remaining_scope='Component-supported OS49 and source-moduli loops are separate.'))
59: (ROOT/'code/part3_fourfold/results_mapping.json').write_text(json.dumps(mapping,indent=2)+'\n')
60: qa=(ROOT/'code/part3_fourfold/qa_original_cox_descent.py').read_text()
61: qa=qa.replace('P3K.33','P3K.35').replace('k33','k35').replace('part3_original_cox_descent','part3_weighted_shorter_loop')
62: (ROOT/'code/part3_fourfold/qa_weighted_shorter_loop.py').write_text(qa)
63: print('Exported audited P3K.35, all thirty branches, both signs, complete global maps and exact endpoint normalization.')
