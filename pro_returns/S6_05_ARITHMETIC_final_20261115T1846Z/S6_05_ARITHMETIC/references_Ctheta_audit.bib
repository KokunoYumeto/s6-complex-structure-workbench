@incollection{waldschmidt1988theta,
  author={Waldschmidt, Michel},
  title={Fonctions th\^eta et nombres transcendants},
  booktitle={S\'eminaire de Th\'eorie des Nombres de Bordeaux, 1987--1988},
  number={15}, pages={1--7}, year={1988},
  url={https://webusers.imj-prg.fr/~michel.waldschmidt/articles/pdf/PPN320141322_0016__0_0.pdf},
  note={Full author-public scan opened and visually read, printed pp.15-02--15-07. Page15-03 states the exact s2-normalized CM theta transcendence result and attributes it to Bertrand1982; the complete original Bertrand proof has not been retrieved. Page15-05 gives an explicit periodic-functional-equation theorem requiring algebraic q=exp(i pi tau).}
