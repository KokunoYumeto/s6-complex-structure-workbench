1: #!/usr/bin/env python3
2: """Export the complete reviewed real-trace argument, retaining all formulas."""
3: from pathlib import Path
4: import re
5: root=Path(__file__).resolve().parents[2]
6: source=(root/'notes/part3_fourfold.md').read_text()
7: source+='\n'+(root/'notes/part3_os45.md').read_text().replace('# P3K.10.','## P3K.10.',1)
8: source+='\n'+(root/'notes/part3_higher_parameter.md').read_text().replace('# P3K.11.','## P3K.11.',1)
9: vertical=(root/'notes/part3_vertical_scope.md').read_text()
10: vertical=vertical[vertical.index('## P3K.12.'):]
11: source+='\n'+vertical
12: source+='\n'+(root/'notes/part3_log_caps.md').read_text().replace('# P3K.15.','## P3K.15.',1)
13: source+='\n'+(root/'notes/part3_seifert_scope.md').read_text().replace('# P3K.16.','## P3K.16.',1)
14: source+='\n'+(root/'notes/part3_flop_cobordism.md').read_text().replace('# P3K.17.','## P3K.17.',1)
15: caps=(root/'notes/part3_cap_restrictions.md').read_text()
16: source+='\n'+caps[caps.index('## P3K.18.'): ]
17: source+='\n'+(root/'notes/part3_whole_zero.md').read_text()
18: source+='\n'+(root/'notes/part3_source_reduction.md').read_text()
19: source+='\n'+(root/'notes/part3_primitive_sources.md').read_text()
20: parts=re.split(r'^## (P3K\.(?:[1-9]|1[0-9]|2[0-2]))\. Proved: (.+)\n',source,flags=re.M)
21: assert len(parts)==67
22: pieces=[r'\section{The local obstruction and the real trace of the actual return}'+'\n']
23: def markdown_table(match):
24:     rows=[line.strip().strip('|').split('|') for line in match.group(0).strip().splitlines()]
25:     rows=[row for row in rows if not all(set(c.strip()) <= set('-: ') for c in row)]
26:     def cell(c):
27:         c=c.strip()
28:         return r'\('+c.replace('−','-')+r'\)' if re.fullmatch('[−-][0-9]+',c) else c
29:     body=[' & '.join(cell(c) for c in row)+r' \\' for row in rows]
30:     spec='c p{0.48\\textwidth} c c c' if len(rows[0])==5 else 'c l l'
31:     return '\n'+r'\begin{center}\small\begin{tabular}{'+spec+r'}\hline'+'\n'+body[0]+'\n'+r'\hline'+'\n'+'\n'.join(body[1:])+'\n'+r'\hline\end{tabular}\end{center}'+'\n'
32: 
33: def tex(s):
34:     s=re.sub(r'(?m)^\|[^\n]+\|\n(?:\|[^\n]+\|\n)+',markdown_table,s)
35:     s=s.replace('**End of proof.**','')
36:     s=re.sub(r'\*\*Proof: (.*?)\.\*\*',lambda m:r'\par\medskip\noindent\textbf{'+m.group(1).capitalize()+r'.}\enspace',s)
37:     s=s.replace('**Proof.**','')
38:     s=re.sub(r'\*\*(.*?)\*\*',lambda m:r'\textbf{'+m.group(1)+'}',s)
39:     s=re.sub(r'`([^`]+)`',lambda m:r'\path{'+m.group(1)+'}',s)
40:     s=re.sub(r'^#{1,2} (.+)$',lambda m:r'\subsection{'+m.group(1)+'}',s,flags=re.M)
41:     return s.strip()+'\n'
42: for k in range(1,len(parts),3):
43:     ident,title,body=parts[k:k+3]
44:     after=''
45:     if ident in {'P3K.1','P3K.2','P3K.3','P3K.4'}:
46:         statement,proof=body.split('**Proof.**',1)
47:         proof,after=proof.split('**End of proof.**',1)
48:     elif ident=='P3K.5':
49:         statement=(r'The integral connecting class from the marked boundary '
50:             r'\(T^3\) has square zero and pairs trivially with every extension '
51:             r'of the page line.  In particular an odd cap correction does not '
52:             r'change the normal Euler square.')
53:         proof=body
54:     elif ident=='P3K.6':
55:         marker='**Proof: the actual orbit trivialization.**'
56:         statement,proof=body.split(marker,1)
57:         proof=marker+proof
58:     elif ident=='P3K.7':
59:         statement=(r'The real trace gives a spin bordism carrying the Euler '
60:             r'line from the actual covered conifold return to a normal sphere '
61:             r'bundle.  Its index is zero.  The original return also has index '
62:             r'zero, and its actual Hopf-lift gluing is the standard sphere.')
63:         proof=body
64:     elif ident=='P3K.8':
65:         statement=(r'The same actual return index vanishes by a second '
66:             r'calculation: vertical sphere quantization, an explicit marked '
67:             r'cap switch, and acyclicity of the elliptic Picard line.  This '
68:             r'calculation does not evaluate the page signature, its line '
69:             r'square, or its first Pontryagin number.')
70:         proof=body
71:     elif ident=='P3K.9':
72:         marker='**Proof: frames on the two pieces.**'
73:         statement,proof=body.split(marker,1)
74:         proof=marker+proof
75:     elif ident=='P3K.10':
76:         marker='**Proof: the source and its section.**'
77:         statement,proof=body.split(marker,1)
78:         proof=marker+proof
79:     elif ident=='P3K.11':
80:         marker='**Proof: the integral orbifold complex.**'
81:         statement,proof=body.split(marker,1)
82:         proof=marker+proof
83:     elif ident=='P3K.15':
84:         marker='**Proof: semifreeness from the actual fixed sphere.**'
85:         statement,proof=body.split(marker,1)
86:         proof,after=proof.split('**End of proof.**',1)
87:         proof=marker+proof
88:     elif ident=='P3K.16':
89:         marker='**Proof: construction of the map.**'
90:         statement,proof=body.split(marker,1)
91:         proof,after=proof.split('**End of proof.**',1)
92:         proof=marker+proof
93:     elif ident=='P3K.17':
94:         marker='**Proof: the real master space and its actual resolution maps.**'
95:         statement,proof=body.split(marker,1)
96:         proof,after=proof.split('**End of proof.**',1)
97:         proof=marker+proof
98:     elif ident=='P3K.19':
99:         marker='**Proof: the actual component maps and their multiplicities.**'
100:         statement,proof=body.split(marker,1)
101:         proof,after=proof.split('**End of proof.**',1)
102:         proof=marker+proof
103:     elif ident=='P3K.22':
104:         marker='**Proof: the source automorphisms and the line lift.**'
105:         statement,proof=body.split(marker,1)
106:         proof,after=proof.split('**End of proof.**',1)
107:         proof=marker+proof
108:     elif ident in {'P3K.20','P3K.21'}:
109:         marker={'P3K.20':'**Proof: the actual line-frame determinant.**',
110:                 'P3K.21':'**Proof: the marked quadratic root.**'}[ident]
111:         statement,proof=body.split(marker,1)
112:         proof,after=proof.split('**End of proof.**',1)
113:         proof=marker+proof
114:     else:
115:         statement,proof=body.split('**Proof.**',1)
116:         proof,after=proof.split('**End of proof.**',1)
117:     pieces.append('\\begin{statement}{'+ident+'}{Proved}\n'+tex(statement)+'\\end{statement}\n')
118:     pieces.append('\\begin{proof}\n'+tex(proof)+'\\end{proof}\n')
119:     if after.strip():
120:         pieces.append(tex(after))
121: (root/'notes/part3_fourfold.tex').write_text('\n'.join(pieces))
122: print('Exported P3K.1--22 in full to notes/part3_fourfold.tex')
