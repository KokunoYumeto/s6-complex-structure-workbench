1: #!/usr/bin/env python3
2: """Export the complete reviewed real-trace argument, retaining all formulas."""
3: from pathlib import Path
4: import re
5: root=Path(__file__).resolve().parents[2]
6: source=(root/'notes/part3_fourfold.md').read_text()
7: source+='\n'+(root/'notes/part3_os45.md').read_text().replace('# P3K.10.','## P3K.10.',1)
8: source+='\n'+(root/'notes/part3_higher_parameter.md').read_text().replace('# P3K.11.','## P3K.11.',1)
9: vertical=(root/'notes/part3_vertical_scope.md').read_text()
10: vertical=vertical[vertical.index('## P3K.12.'):]
11: source+='\n'+vertical
12: source+='\n'+(root/'notes/part3_log_caps.md').read_text().replace('# P3K.15.','## P3K.15.',1)
13: source+='\n'+(root/'notes/part3_seifert_scope.md').read_text().replace('# P3K.16.','## P3K.16.',1)
14: source+='\n'+(root/'notes/part3_flop_cobordism.md').read_text().replace('# P3K.17.','## P3K.17.',1)
15: caps=(root/'notes/part3_cap_restrictions.md').read_text()
16: source+='\n'+caps[caps.index('## P3K.18.'): ]
17: parts=re.split(r'^## (P3K\.(?:[1-9]|1[0-9]))\. Proved: (.+)\n',source,flags=re.M)
18: assert len(parts)==58
19: pieces=[r'\section{The local obstruction and the real trace of the actual return}'+'\n']
20: def tex(s):
21:     s=s.replace('**End of proof.**','')
22:     s=re.sub(r'\*\*Proof: (.*?)\.\*\*',lambda m:r'\par\medskip\noindent\textbf{'+m.group(1).capitalize()+r'.}\enspace',s)
23:     s=s.replace('**Proof.**','')
24:     s=re.sub(r'\*\*(.*?)\*\*',lambda m:r'\textbf{'+m.group(1)+'}',s)
25:     s=re.sub(r'`([^`]+)`',lambda m:r'\path{'+m.group(1)+'}',s)
26:     s=re.sub(r'^## (.+)$',lambda m:r'\subsection{'+m.group(1)+'}',s,flags=re.M)
27:     return s.strip()+'\n'
28: for k in range(1,len(parts),3):
29:     ident,title,body=parts[k:k+3]
30:     after=''
31:     if ident in {'P3K.1','P3K.2','P3K.3','P3K.4'}:
32:         statement,proof=body.split('**Proof.**',1)
33:         proof,after=proof.split('**End of proof.**',1)
34:     elif ident=='P3K.5':
35:         statement=(r'The integral connecting class from the marked boundary '
36:             r'\(T^3\) has square zero and pairs trivially with every extension '
37:             r'of the page line.  In particular an odd cap correction does not '
38:             r'change the normal Euler square.')
39:         proof=body
40:     elif ident=='P3K.6':
41:         marker='**Proof: the actual orbit trivialization.**'
42:         statement,proof=body.split(marker,1)
43:         proof=marker+proof
44:     elif ident=='P3K.7':
45:         statement=(r'The real trace gives a spin bordism carrying the Euler '
46:             r'line from the actual covered conifold return to a normal sphere '
47:             r'bundle.  Its index is zero.  The original return also has index '
48:             r'zero, and its actual Hopf-lift gluing is the standard sphere.')
49:         proof=body
50:     elif ident=='P3K.8':
51:         statement=(r'The same actual return index vanishes by a second '
52:             r'calculation: vertical sphere quantization, an explicit marked '
53:             r'cap switch, and acyclicity of the elliptic Picard line.  This '
54:             r'calculation does not evaluate the page signature, its line '
55:             r'square, or its first Pontryagin number.')
56:         proof=body
57:     elif ident=='P3K.9':
58:         marker='**Proof: frames on the two pieces.**'
59:         statement,proof=body.split(marker,1)
60:         proof=marker+proof
61:     elif ident=='P3K.10':
62:         marker='**Proof: the source and its section.**'
63:         statement,proof=body.split(marker,1)
64:         proof=marker+proof
65:     elif ident=='P3K.11':
66:         marker='**Proof: the integral orbifold complex.**'
67:         statement,proof=body.split(marker,1)
68:         proof=marker+proof
69:     elif ident=='P3K.15':
70:         marker='**Proof: semifreeness from the actual fixed sphere.**'
71:         statement,proof=body.split(marker,1)
72:         proof,after=proof.split('**End of proof.**',1)
73:         proof=marker+proof
74:     elif ident=='P3K.16':
75:         marker='**Proof: construction of the map.**'
76:         statement,proof=body.split(marker,1)
77:         proof,after=proof.split('**End of proof.**',1)
78:         proof=marker+proof
79:     elif ident=='P3K.17':
80:         marker='**Proof: the real master space and its actual resolution maps.**'
81:         statement,proof=body.split(marker,1)
82:         proof,after=proof.split('**End of proof.**',1)
83:         proof=marker+proof
84:     elif ident=='P3K.19':
85:         marker='**Proof: the actual component maps and their multiplicities.**'
86:         statement,proof=body.split(marker,1)
87:         proof,after=proof.split('**End of proof.**',1)
88:         proof=marker+proof
89:     else:
90:         statement,proof=body.split('**Proof.**',1)
91:         proof,after=proof.split('**End of proof.**',1)
92:     pieces.append('\\begin{statement}{'+ident+'}{Proved}\n'+tex(statement)+'\\end{statement}\n')
93:     pieces.append('\\begin{proof}\n'+tex(proof)+'\\end{proof}\n')
94:     if after.strip():
95:         pieces.append(tex(after))
96: (root/'notes/part3_fourfold.tex').write_text('\n'.join(pieces))
97: print('Exported P3K.1--19 in full to notes/part3_fourfold.tex')
