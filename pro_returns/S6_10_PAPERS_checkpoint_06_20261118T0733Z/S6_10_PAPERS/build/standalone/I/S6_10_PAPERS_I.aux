\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The exact parameter disc for the standard fixed data. The coordinate map is $w=e^{-\pi i c}$ and the coarser coordinate map is $u=w^2$. The imaginary diameter is the fixed locus of $w\DOTSB \mapstochar \rightarrow -\bar  w$, which is the reflected-family map. The two boundary obstructions use the meridian comparison at the puncture and the intrinsic Albanese nome at the outer circle. The special fibres are over $t=0,1,\infty $ in every member, as indicated in Figure~\ref {fig:I:orbifold}.}}{97}{figure.2}\protected@file@percent }
\newlabel{fig:I:parameter-disc}{{2}{97}{The exact parameter disc for the standard fixed data. The coordinate map is $w=e^{-\pi i c}$ and the coarser coordinate map is $u=w^2$. The imaginary diameter is the fixed locus of $w\mapsto -\bar w$, which is the reflected-family map. The two boundary obstructions use the meridian comparison at the puncture and the intrinsic Albanese nome at the outer circle. The special fibres are over $t=0,1,\infty $ in every member, as indicated in Figure~\ref {fig:I:orbifold}}{figure.2}{}}
\newlabel{fig:I:parameter-disc@cref}{{[figure][2][]2}{[1][96][]97}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces A fundamental set for the index-twelve monodromy kernel in the real parabolic stabilizer of $d$. The base is a modular fundamental set with its rotation coordinate; the fibre is the indicated Heisenberg parallelepiped. The displayed face maps include the central shears. The representative map and the boundary identifications are proved in \ref {I:monodromy-fundamental-set}; the index twelve occurs in the central fibre coordinate.}}{97}{figure.3}\protected@file@percent }
\newlabel{fig:I:monodromy-domain}{{3}{97}{A fundamental set for the index-twelve monodromy kernel in the real parabolic stabilizer of $d$. The base is a modular fundamental set with its rotation coordinate; the fibre is the indicated Heisenberg parallelepiped. The displayed face maps include the central shears. The representative map and the boundary identifications are proved in \ref {I:monodromy-fundamental-set}; the index twelve occurs in the central fibre coordinate}{figure.3}{}}
\newlabel{fig:I:monodromy-domain@cref}{{[figure][3][]3}{[1][96][]97}{}{}{}}
