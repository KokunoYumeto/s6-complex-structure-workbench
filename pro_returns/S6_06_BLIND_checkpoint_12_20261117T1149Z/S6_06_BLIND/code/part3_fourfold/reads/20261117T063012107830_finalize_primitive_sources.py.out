1: #!/usr/bin/env python3
2: """Export independently audited K22, with its complete matrices and scope."""
3: from pathlib import Path
4: from datetime import datetime,timezone
5: import json
6: root=Path(__file__).resolve().parents[2]
7: names=['notes/part3_primitive_sources.md','code/part3_fourfold/export_trace_tex.py',
8:        'code/part3_fourfold/results_mapping.json']
9: with (root/'records/literature_fourfold.md').open('a') as f:
10:  for name in names:
11:   f.write('\n- '+datetime.now(timezone.utc).isoformat()+' — Opened current-team `'+name+'`; reason: export root-audited K22; material: exact primitive-source matrices, inversion, all orbit/Hopf gluing maps, ten sphere constructions and their signed return indices.\n')
12: p=root/'code/part3_fourfold/export_trace_tex.py';s=p.read_text()
13: s=s.replace("source+='\\n'+(root/'notes/part3_source_reduction.md').read_text()\n",
14:             "source+='\\n'+(root/'notes/part3_source_reduction.md').read_text()\nsource+='\\n'+(root/'notes/part3_primitive_sources.md').read_text()\n")
15: s=s.replace('2[01]','2[0-2]').replace('assert len(parts)==64','assert len(parts)==67')
16: s=s.replace("    body=[' & '.join(c.strip() for c in row)+r' \\\\' for row in rows]\n",
17:             "    def cell(c):\n        c=c.strip()\n        return r'\\('+c.replace('−','-')+r'\\)' if re.fullmatch('[−-][0-9]+',c) else c\n    body=[' & '.join(cell(c) for c in row)+r' \\\\' for row in rows]\n    spec='c p{0.48\\\\textwidth} c c c' if len(rows[0])==5 else 'c l l'\n")
18: s=s.replace("r'\\begin{center}\\small\\begin{tabular}{c l l}\\hline'",
19:             "r'\\begin{center}\\small\\begin{tabular}{'+spec+r'}\\hline'")
20: s=s.replace("    elif ident in {'P3K.20','P3K.21'}:",
21:             "    elif ident=='P3K.22':\n        marker='**Proof: the source automorphisms and the line lift.**'\n        statement,proof=body.split(marker,1)\n        proof,after=proof.split('**End of proof.**',1)\n        proof=marker+proof\n    elif ident in {'P3K.20','P3K.21'}:")
22: s=s.replace('Exported P3K.1--21','Exported P3K.1--22')
23: p.write_text(s)
24: p=root/'code/part3_fourfold/results_mapping.json';data=json.loads(p.read_text())
25: data['results']=[r for r in data['results'] if r['id']!='P3K.22']
26: data['results'].append(dict(id='P3K.22',status='Proved',item_of_prompt='3.4',
27:  proof_file='notes/part3_primitive_sources.md',latex_file='notes/part3_fourfold.tex',
28:  statement='Ten primitive-translation source profiles give explicit complex six-sphere families; exact inversion removes the integral boundary linking coefficients and all Mayer–Vietoris maps are exported.',
29:  own_value={'OS45':{'profiles':2,'A':-3,'Theta7':25},'OS47':{'profiles':3,'A':-6,'Theta7':22},'OS55':{'profiles':2,'A':-9,'Theta7':19},'OS56':{'profiles':3,'A':-14,'Theta7':14}},
30:  codes=['code/part3_fourfold/primitive_source_translation.py','code/part3_fourfold/primitive_orbit_filling.py'],
31:  certificates=['code/part3_fourfold/primitive_source_translation.json','code/part3_fourfold/primitive_orbit_filling.json'],
32:  exact_maps=['extended source inversion and translation','canonical chord line lift','source Wang complex','primitive Thom maps','literal inversion on every boundary torus','all cap exterior-power maps','all orbit and Hopf Mayer–Vietoris matrices','degree-one norm-shell page with original Picard line'],
33:  additional_obstruction='A primitive smooth cap of multiplicity m contributes (Z/m)^2 to orbit H2 when the H1 Seifert matrix is unimodular; sphere members in this smooth-site scope have only order-one caps.',
34:  scope='Specified standard vertical-edge fan and one positive gamma cap for the return table; arbitrary order-one smooth-site collars for the topology statement. Singular-source cap replacements and general fan-return changes retain separate comparisons.'))
35: p.write_text(json.dumps(data,indent=2)+'\n')
36: print('Finalized root-audited K22 with all ten source profiles and exact construction scope.')
