  "main_status_string_bindings": [
    {
      "section": "mechanisms",
      "role": "A",
      "text": "Theta transformation laws fix the additive constant, division identities control the norm, and the local-height product formula fixes its arithmetic normalization.",
      "occurrences": 1
    },
    {
      "section": "mechanisms",
      "role": "B",
      "text": "Integral centralizers, finite norm maps and cusp winding determine the parameter equivalence, while the marked reflection and cap-meridian maps determine the real forms.",
      "occurrences": 1
    },
    {
      "section": "mechanisms",
      "role": "C",
      "text": "The integral congruence kernel determines the parabolic quotient, and the wedge equation with its Hermitian form determines the fibre strata.",
      "occurrences": 1
    },
    {
      "section": "mechanisms",
      "role": "D",
      "text": "Root characters and logarithmic residues compute the connecting scalar and direct images, exterior quotients by $dt$ give the ordinary modules, and theta factors with cusp Cartier frames give the coefficient cocycles.",
      "occurrences": 1
    },
    {
      "section": "mechanisms",
      "role": "E",
      "text": "Weighted section counts and local Koszul modules compute every Picard twist, while the nonzero Kodaira--Spencer class gives the coordinate on the Kuranishi line.",
      "occurrences": 1
    },
    {
      "section": "mechanisms",
      "role": "F",
      "text": "The intrinsic canonical system recovers the marked base, finite-orbit vanishing kills horizontal meridians, and their constant ratio across the connected compact corner contradicts the nonzero cusp coefficient.",
      "occurrences": 1
    },
    {
      "section": "mechanisms",
      "role": "G",
      "text": "The intrinsic Albanese invariant detects the outer boundary, and the exact dual-period equations with their quadratic cancellation determine nonseparation and every marked closed-group limit.",
      "occurrences": 1
    },
    {
      "section": "statuses",
      "role": "A",
      "text": "New period evaluations, norm values and level classification, using the elliptic section of \\cite[Remark~3.12, p.~19]{AC2026}.",
      "occurrences": 1
    },
    {
      "section": "statuses",
      "role": "B",
      "text": "New classification for the displayed discrete data and real forms; the standard $2\\mathbb Z$ equivalence is known \\cite[Theorem~1.4, p.~3]{DuEtAl2026v1}.",
      "occurrences": 1
    },
    {
      "section": "statuses",
      "role": "C",
      "text": "New integral monodromy and maximal proper domain, answering \\cite[Remark~8.4, pp.~23--24]{Engel2026}.",
      "occurrences": 1
    },
    {
      "section": "statuses",
      "role": "D",
      "text": "New evaluated cohomology and coefficient atlas; the ordinary-module calculation corrects \\cite[Remark~9.21, p.~81]{AC2026}.",
      "occurrences": 1
    },
    {
      "section": "statuses",
      "role": "E",
      "text": "New all-twist and higher-multiplicity formulas; the standard untwisted deformation results are known \\cite[Theorem~6.12, pp.~81--82; Proposition~6.16, p.~85]{DuEtAl2026v1}.",
      "occurrences": 1
    },
    {
      "section": "statuses",
      "role": "F",
      "text": "New filling obstruction and untwisted plumbing; the Euler calculation corrects the proposed central model in \\cite[Conjecture~8.2, p.~22]{Engel2026}.",
      "occurrences": 1
    },
    {
      "section": "statuses",
      "role": "G",
      "text": "New boundary obstruction and marked limit formulas, using the annihilator duality of \\cite[Theorem~3.1, p.~2017]{Cornulier2011}.",
      "occurrences": 1
    },
    {
      "section": "known_new_rows",
      "role": "A",
      "text": "New explicit evaluations and sharp norm bounds from the known section \\cite[Remark~3.12, p.~19]{AC2026}; the quotient and height inputs are \\cite[Definition~2.3, p.~5; proof of Lemma~2.1, pp.~3--4]{Engel2026}, transported by \\cref{I:weierstrass-comparison}.",
      "occurrences": 1
    },
    {
      "section": "known_new_rows",
      "role": "B",
      "text": "New discrete-data and real-form extensions of the standard equivalence \\cite[Theorem~1.4, p.~3]{DuEtAl2026v1}; the higher construction is \\cite[Theorem~1.1, p.~1; Section~2.1, pp.~4--6]{ViaclovskyLog2026}, with $(k,l)=(1,1)$ giving the standard data.",
      "occurrences": 1
    },
    {
      "section": "known_new_rows",
      "role": "C",
      "text": "New exact group, quotient and proper-domain answer to \\cite[Remark~8.4, pp.~23--24]{Engel2026}; the fibre tests use the integral wedge equation of \\cite[Lemma~9.2, p.~65]{AC2026} with the period row $\\beta=\\beta_c$.",
      "occurrences": 1
    },
    {
      "section": "known_new_rows",
      "role": "D",
      "text": "New value of the Hodge integer, full cohomology and coefficient representatives extending \\cite[Theorem~9.1(vi), p.~65; Proposition~9.20, p.~80]{AC2026}; the degree-one cusp module corrects its Remark~9.21, p.~81, and specifies the degree dependence of Remark~1.3, p.~5.",
      "occurrences": 1
    },
    {
      "section": "known_new_rows",
      "role": "E",
      "text": "New Picard-twist and coprime-root calculations extending the known standard tangent, Kuranishi and automorphism results \\cite[Theorems~1.3--1.4, p.~3; Theorem~6.12, pp.~81--82; Proposition~6.16, p.~85; Theorem~7.14, p.~95]{DuEtAl2026v1}, under the parameter map of \\cref{night:P5.7}.",
      "occurrences": 1
    },
    {
      "section": "known_new_rows",
      "role": "F",
      "text": "New marked nonfilling obstruction and explicit untwisted filling in the degeneration setting of \\cite[Remark~8.1, p.~22]{Engel2026}; virtual Euler number zero excludes the particular central model in its Conjecture~8.2, p.~22.",
      "occurrences": 1
    },
    {
      "section": "known_new_rows",
      "role": "G",
      "text": "New intrinsic boundary and marked additive-limit calculations; the map $w\\mapsto iw/216$ supplies the modular boundary, and \\cite[Theorem~3.1, p.~2017]{Cornulier2011} supplies closed-group duality under the real annihilator map.",
      "occurrences": 1
    }
  ],
