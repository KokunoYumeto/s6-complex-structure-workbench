1: #!/usr/bin/env python3
2: """Export the audited selected-cusp source return, P3F.56, separately."""
3: from pathlib import Path
4: from datetime import datetime, timezone
5: import re
6: import shutil
7: import subprocess
8: 
9: root = Path(__file__).resolve().parents[2]
10: source = root / 'notes/part3_source_cusp_trace_working.md'
11: text = source.read_text()
12: assert 'Proved as P3F.56' in text
13: assert 'P3F.55 Kummer normalization comparison' in text
14: stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
15: shutil.copy2(source, root / 'records' / f'pre_export_{stamp}_{source.name}')
16: body = text[text.index('## SC.1.'):text.index('## Audit and preservation record')]
17: body = re.sub(r'(?m)^## (.+)$',
18:               lambda m: r'\par\medskip\noindent\textbf{' + m.group(1)
19:               + r'}\par\nobreak', body)
20: body = re.sub(r'`(code/[^`]+)`', lambda m: r'\path{' + m.group(1) + '}', body)
21: tex = subprocess.run(
22:     ['pandoc', '-f', 'markdown+tex_math_single_backslash+raw_tex',
23:      '-t', 'latex', '--wrap=preserve'],
24:     input=body, text=True, capture_output=True, check=True).stdout
25: 
26: statement = r"""
27: Use the exact marked E7 source of P3F.54,
28: \[
29:  y^2=x^3+3r(u)x^2+t x+1,\qquad G=(0,1),\qquad
30:  r(u)=\frac{1-2u^3}{3u^2},\quad t_0(u)=u^2-\frac2u.
31: \]
32: Fix either actual one-cap sphere datum of P3F.41:
33: \[
34:  \begin{array}{c|c|c}
35:  (M,Q)&\text{order at }III^*&\text{root fibre}\\ \hline
36:  (\mathcal O(2G-O),G)&m=4l+3,\ l\ge0&III\\
37:  (\mathcal O(G-O),2G)&m=4l,\ l\ge1&\text{smooth}.
38:  \end{array}
39: \]
40: Keep its norm numerator \(n=\pm1\), its line lift and finite character,
41: and its sufficiently small nonzero scalar fixed. There is no additional
42: logarithmic disc on either member of the coalescing finite-node pair.
43: Use the standard vertical-edge toric fan of this construction.
44: 
45: Let \(u_*^3=-1\), and take the actual closed twofold source family
46: \[
47:  u+u^{-2}=\rho^2,\qquad u(0)=u_*.
48: \]
49: For one positive \(\rho\)-loop its forward physical return \(\Phi\)
50: has
51: \[
52:  A_{\rm Jin}(f)=1,\qquad [\Phi]=1\in\Theta_7\cong\mathbb Z/28.
53: \]
54: Here \(f\) is the quotient of that physical return with the orientations
55: and Hopf transfer of P3F.22. This is two positive turns about \(u_*\)
56: in the marked source parameter; the scalar has zero winding.
57: The actual sphere mapping torus is
58: \((S^1\times S^6)\mathbin{\#}\Sigma_1\). Both its spin structures
59: have Eells--Kuiper invariant \(1/28\), so it is not diffeomorphic to
60: \(S^1\times S^6\), including without an orientation requirement.
61: 
62: This particular full \(\rho\)-family has no descent as an oriented
63: smooth sphere bundle through the actual degree-two cover
64: \(p:D_\rho^*\to D_a^*\), \(a=\rho^2\), with \(u\) the analytic
65: inverse of \(a(u)=u+u^{-2}\) near \(u_*\). Indeed its clutch class
66: one cannot be twice a class in \(\Theta_7\).
67: 
68: The selected-node separation has braid \(\sigma^{12}\), and its
69: retained elliptic boundary map is the once-punctured-torus relation
70: \((gh)^6=T_{\partial}\). The proof below gives the actual ambient,
71: line, normal and cap morphisms carrying the local lifted link to this
72: return. It assigns no return to another fan or another source puncture.
73: """
74: out = ('\\subsection{The actual selected-cusp double source return}\n'
75:        '\\begin{statement}{P3F.56}{Proved}\n' + statement
76:        + '\n\\end{statement}\n\\begin{proof}\n' + tex
77:        + '\n\\end{proof}\n')
78: (root / 'notes/part3_source_cusp_trace.tex').write_text(out)
79: preamble = (root / 'S6_06_BLIND_paper.tex').read_text().split(r'\begin{document}')[0]
80: (root / 'records/part3_source_cusp_trace_compile.tex').write_text(
81:     preamble + '\n' + r'\begin{document}' + '\n'
82:     + r'\input{notes/part3_source_cusp_trace.tex}' + '\n'
83:     + r'\end{document}' + '\n')
84: print('Exported P3F.56 with the literal source/cap/line/fan scope and the F55 normalization bridge.')
