116:         # Half turn followed by actual y inversion; compare D^-2.
117:         assert (m-6*p)%m == (-6*p)%m
118:         for nn in (-1,1):
119:             for kk in (2,3,4):
120:                 N=kk*m
121:                 PA=S.Matrix([[1,0],[0,0]])
122:                 PB=S.Matrix([[1,bb],[-aa,-2]])
123:                 E=S.Matrix([[0,0],[0,N]])
124:                 H=PA+PB+E
125:                 check(f"H determinant {aa} {m} {nn} {N}", H.det()-(2*N-2))
126:                 rows.append({"a":aa,"b":bb,"m":m,"n":nn,"N":N,
127:                              "P_A":list(PA),"P_B":list(PB),"E":list(E),
128:                              "H":list(H),"det_H":int(H.det()),
129:                              "minimal_X_exponent":str(xexp),
130:                              "minimal_Y_exponent":str(yexp)})
131: 
