1: #!/usr/bin/env python3
2: """Export the exact scalar marked-product obstruction as P3K.61."""
3: from pathlib import Path
4: from datetime import datetime,timezone
5: import hashlib,json,re
6: ROOT=Path(__file__).resolve().parents[2]
7: source=ROOT/'notes/part3_scalar_outer_clutch_audit.md'
8: stamp=datetime.now(timezone.utc).isoformat()
9: with (ROOT/'records/literature_fourfold.md').open('a') as log:
10:  log.write('\n- '+stamp+' — Opened '+str(source.relative_to(ROOT))+'. Reason: export exact K61 maps and marked-product obstruction. Material: actual scalar seam, full outer positive-weight determinant transition, and endpoint/bundle-map contradiction; no corrected global residue is asserted.\n')
11: raw=source.read_text()
12: body='## SOC.1.'+raw.split('## SOC.1.',1)[1].split('## SOC.4.',1)[0]
13: body=body.replace('the same actual\nlogarithms and cutoff as SCN.1','the actual\nlogarithms on the cut disc and a smooth cutoff zero on the initial collar and one on the final collar')
14: statement=r'''For an actual primitive scalar family of P3K.22, including
15: the OS45 family of P3K.10, retain its positive physical circle, full
16: source and line units, actual cap-to-ordinary gluing and forward
17: parameter arrow. On every nonzero signed degree-\(M\) pullback of
18: its primitive scalar loop, the three labelled cusp curves, their two
19: labelled vertices and their positive complex curve orientations admit
20: no periodic smooth product intertwining the physical delta action and
21: carrying all these marked submanifolds to constant copies.
22: 
23: The literal comparison at the second outer fixed branch between the
24: fixed-curve native product and the horizontal-curve native product is
25: \[
26:  z_1=(g/\kappa)z_0,\qquad
27:  (N_{1,-},N_{1,+})=
28:  \bigl((\eta/\alpha)N_{0,-},\,
29:        (\kappa\alpha/(g\eta))N_{0,+}\bigr).
30: \]
31: After conjugating the negative-weight first line, its determinant is
32: \[
33:  \det_+\Gamma
34:  =\frac\kappa g\frac\alpha{\overline\alpha}
35:                  \frac{\overline\eta}{\eta},
36:  \qquad\operatorname{wind}(\det_+\Gamma)=-2M.
37: \]
38: The other outer branch comparison is the identity. This identifies
39: the retained outer line clutch missing from P3K.25's claimed
40: parameter-free determinant, and disproves the marked simultaneous
41: equivariant-product premise used in P3K.29, Section3. It assigns no
42: corrected global characteristic number. The separately proved
43: cellular topology, reciprocal-section basis maps, variation symmetry,
44: and stable-frame change identities do not require that premise.'''
45: def tex(s):
46:  s=s.replace(r'\tag{SOC.',r'\tag{P3K.61.SOC.').replace('(SOC.','(P3K.61.SOC.')
47:  s=s.replace(')--(P3K.61.',')--\\allowbreak (P3K.61.')
48:  s=re.sub(r'^## (.+)$',lambda m:r'\par\medskip\noindent\textbf{'+m.group(1)+r'.}\par\nopagebreak[4]',s,flags=re.M)
49:  s=re.sub(r'`([^`]+)`',lambda m:r'\path{'+m.group(1)+'}',s)
50:  return s.strip()+'\n'
51: export=r'\begin{statement}{P3K.61}{Proved}'+'\n'+tex(statement)+r'\end{statement}'+'\n'+r'\begin{proof}'+'\n'+tex(body)+r'\end{proof}'+'\n'
52: assert not re.search(r'(?<!\\)#',export)
53: (ROOT/'notes/part3_scalar_outer_clutch_obstruction.tex').write_text(export)
54: (ROOT/'notes/part3_scalar_outer_clutch_obstruction.md').write_text('# P3K.61. Exact outer scalar clutch and marked-product obstruction\n\n'+statement+'\n\n**Proof.**\n\n'+body+'\n\n**End of proof.**\n')
55: mp=ROOT/'code/part3_fourfold/results_mapping.json';mapping=json.loads(mp.read_text())
56: mapping['results']=[r for r in mapping['results'] if r.get('id')!='P3K.61']
57: mapping['results'].append(dict(id='P3K.61',status='Proved',item_of_prompt='3.4',
58:  statement='For nonzero signed scalar winding M, the actual marked three-curve plumbing has no periodic delta-equivariant product; the exact outer positive-normal determinant clutch has winding -2M.',
59:  proof_file='notes/part3_scalar_outer_clutch_obstruction.md',latex_file='notes/part3_scalar_outer_clutch_obstruction.tex',
60:  working_proof=str(source.relative_to(ROOT)),source_sha256=hashlib.sha256(raw.encode()).hexdigest(),
61:  correction_scope=['K25 outer determinant pullback assertion misses the actual clutch','K29 simultaneous marked equivariant product premise fails'],
62:  preserved_scope=['cellular topology','reciprocal-section maps','variation symmetry','frame-change identity','separate fixed/native star products'],
63:  remaining_scope='No corrected closed fixed-base residue or replacement all-fan scalar formula is assigned.'))
64: mp.write_text(json.dumps(mapping,indent=2)+'\n')
65: print(json.dumps(dict(id='P3K.61',source_sha256=hashlib.sha256(raw.encode()).hexdigest(),tex_file='notes/part3_scalar_outer_clutch_obstruction.tex'),indent=2))
