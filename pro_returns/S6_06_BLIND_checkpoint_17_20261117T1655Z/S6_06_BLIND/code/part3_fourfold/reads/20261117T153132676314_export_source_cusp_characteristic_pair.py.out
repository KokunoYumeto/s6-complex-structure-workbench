1: #!/usr/bin/env python3
2: from pathlib import Path
3: import re
4: import subprocess
5: 
6: root=Path(__file__).resolve().parents[2]
7: source=(root/'notes/part3_source_cusp_characteristic_pair_working.md').read_text()
8: body='## SP.1.'+source.split('## SP.1.',1)[1]
9: proof_body,audit_body=body.split('## Audit and computation status',1)
10: statement=r'''
11: Retain the actual positive selected-cusp source loop of P3F.54 and
12: P3F.56, with fixed sufficiently small scalar, the III-star cap, no
13: logarithmic modification on the coalescing finite pair, and the
14: initial physical-delta-edge fan. Its parameter is one positive
15: \(\rho\)-loop, where \(a(u)=\rho^2\), with the literal double
16: source closure and the actual Cox normal product. In Jin's endpoint
17: and positive-meridian conventions its characteristic pair and
18: first-resolution relative coordinates are
19: \[
20:        (k,\ell)=(6,0),\qquad
21:        (m_{\rm rel},n_{\rm rel},s)=(0,-6,1).
22: \]
23: The framed local surgery has pair \((5,-4)\). The actual capped
24: normal sphere bundle in its source-family bordism has pair
25: \((1,4)\). Their oriented sum gives the displayed return pair.
26: This statement concerns the specified initial fan; P3K.40 gives
27: the first fixed-edge flop class \(-5=23\) separately.
28: '''
29: 
30: def convert(text):
31:     text=re.sub(r'(?m)^## (.+)$',lambda m:r'\par\medskip\noindent\textbf{'+m.group(1)+r'}\par\nobreak',text)
32:     text=re.sub(r'(?<![\w{/])(code/[A-Za-z0-9_./-]+)',lambda m:r'\path{'+m.group(1).rstrip('.')+'}'+('.' if m.group(1).endswith('.') else ''),text)
33:     return subprocess.run(['pandoc','-f','markdown+tex_math_single_backslash+raw_tex','-t','latex','--wrap=preserve'],input=text,text=True,capture_output=True,check=True).stdout
34: 
35: tex=(r'\subsection{The actual characteristic pair of the selected-cusp source loop}'+'\n'
36:      +r'\begin{statement}{P3K.42}{Proved}'+'\n'+convert(statement)
37:      +r'\end{statement}'+'\n'+r'\begin{proof}'+'\n'+convert(proof_body)
38:      +r'\end{proof}'+'\n'+convert('## Audit and computation status'+audit_body))
39: (root/'notes/part3_source_cusp_characteristic_pair.tex').write_text(tex)
40: preamble=(root/'code/part3/k38_standalone.tex').read_text().split(r'\begin{document}')[0]
41: (root/'code/part3/k42_standalone.tex').write_text(preamble+'\n'+r'\begin{document}'+'\n'+r'\input{notes/part3_source_cusp_characteristic_pair.tex}'+'\n'+r'\end{document}'+'\n')
42: print('Exported full P3K.42 and standalone wrapper; master input remains unchanged pending visual QA.')
