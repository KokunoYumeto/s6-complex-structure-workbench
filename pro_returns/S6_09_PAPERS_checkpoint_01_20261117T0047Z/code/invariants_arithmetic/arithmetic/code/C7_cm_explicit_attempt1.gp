default(realprecision,110);
E=ellinit([0,0,1,-38,90]);
cmh=x^9-38*x^8+437*x^7-1444*x^6-7942*x^5+82308*x^4-274360*x^3+390963*x^2-130321*x-130321;
cmf=4*x^3-152*x+361;
cmnum=(-19*x+76)*cmh^2+cmf*(deriv(cmh,2)*cmh-deriv(cmh)^2)+(6*x^2-76)*deriv(cmh)*cmh;
cmder=deriv(cmnum)*cmh-2*cmnum*deriv(cmh);
cmres=-cmder^2*cmf-4*cmnum^3+152*19^2*cmnum*cmh^4-361*19^3*cmh^6;
print("elliptic_map_identity_residual=",cmres);
if(cmres!=0,error("CM map identity failed"));
cmbeta=Mod(y,y^2+19);
cmcross=19*x*cmh^2-cmnum;
cmhp=gcd(cmcross,cmder+19*cmbeta*cmh^3);
cmhp=cmhp/pollead(cmhp);
print("kernel_1plusbeta_non2_degree=",poldegree(cmhp));
print("kernel_1plusbeta_non2=",cmhp);
print("h_Q=",subst(cmh,x,4));
print("hprime_Q=",subst(deriv(cmh),x,4));
cma=-3/cmbeta*subst(deriv(cmh),x,4)/subst(cmh,x,4);
cmr2=-(1+cmbeta)*(-3)*subst(cmhp,x,4)/(2*cmbeta*subst(cmh,x,4));
print("s2_exact=",polcoef(cmh,8)/19);
print("a_exact=",cma);
print("r2_exact=",cmr2);
print("x_beta_Q=",subst(cmnum/(19*cmh^2),x,4));
cmperiod=ellperiods(E,1);
cmomega=real(-2*cmperiod[1][1]-cmperiod[1][2]);
cmeta=real(-2*cmperiod[2][1]-cmperiod[2][2]);
cmarea=abs(imag(conj(cmperiod[1][1])*cmperiod[1][2]));
cmu=real(ellpointtoz(E,[4,-2]));
cmzeta=ellzeta(E,cmu);
cmnorm=abs(E.disc)^(1/12)*abs(ellsigma(E,cmu))*exp(-cmu*cmeta*cmu/cmomega/2);
cmbetac=I*sqrt(19);
cmtheta(z)=ellsigma(E,z)*exp(z^2);
cmr2analytic=cmtheta((1+cmbetac)*cmu)/(cmtheta(cmu)*cmtheta(cmbetac*cmu));
cmr2algebraic=subst(lift(cmr2),y,cmbetac);
cmanalytic=ellzeta(E,cmbetac*cmu)+cmbetac*cmzeta+4*cmbetac*cmu;
cmaalgebraic=subst(lift(cma),y,cmbetac);
print("omega1=",cmomega);
print("u=",cmu);
print("area=",cmarea);
print("s2_numeric=",cmeta/cmomega-Pi/cmarea);
print("slope_c=",cmzeta-cmeta*cmu/cmomega);
print("Gaussian=",exp(-Pi*cmu^2/(2*cmarea)));
print("N_Q=",cmnorm);
print("r2_analytic=",cmr2analytic);
print("r2_analytic_minus_algebraic=",cmr2analytic-cmr2algebraic);
print("a_analytic_minus_algebraic=",cmanalytic-cmaalgebraic);
quit;
