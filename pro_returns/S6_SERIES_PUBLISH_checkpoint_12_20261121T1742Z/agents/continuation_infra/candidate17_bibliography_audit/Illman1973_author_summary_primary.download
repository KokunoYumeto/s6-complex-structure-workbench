  <span class="common-title article-title">
    
    
    Equivariant algebraic topology
    
    
  </span>
  
  




      </div>
      



<div class="article-author" style="display:inline-block">
  
    





  


    
      
        




  <div style="margin-bottom:5px; font-size: 16px">
    <a class="author_link" href="/search?&quot;Illman, Sören&quot;-c">Illman, Sören</a>&nbsp;<sup><a href="https://www.idref.fr/14845822X" target="_blank"><img width="16px" height="16px" style="margin-top:-3px; margin-left:3px" src="/static/ptf/img/logo-idref.png" alt="idref"></a></sup>
</div>


      
      





  


      





  


      





  


      





  


      





  


      





  


    
    
      
        





      
    
  
</div>


      <div style="margin-bottom:10px">
        


Annales de l'Institut Fourier, Tome 23 (1973) no. 2, pp. 87-91

        


      </div>

      
      
        <div class="binary-file-icon" style="margin-top:20px;margin-bottom:10px">
          
