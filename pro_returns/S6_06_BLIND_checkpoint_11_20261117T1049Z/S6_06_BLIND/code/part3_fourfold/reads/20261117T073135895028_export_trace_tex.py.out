1: #!/usr/bin/env python3
2: """Export the complete reviewed real-trace argument, retaining all formulas."""
3: from pathlib import Path
4: import re
5: root=Path(__file__).resolve().parents[2]
6: source=(root/'notes/part3_fourfold.md').read_text()
7: source+='\n'+(root/'notes/part3_os45.md').read_text().replace('# P3K.10.','## P3K.10.',1)
8: source+='\n'+(root/'notes/part3_higher_parameter.md').read_text().replace('# P3K.11.','## P3K.11.',1)
9: vertical=(root/'notes/part3_vertical_scope.md').read_text()
10: vertical=vertical[vertical.index('## P3K.12.'):]
11: source+='\n'+vertical
12: source+='\n'+(root/'notes/part3_log_caps.md').read_text().replace('# P3K.15.','## P3K.15.',1)
13: source+='\n'+(root/'notes/part3_seifert_scope.md').read_text().replace('# P3K.16.','## P3K.16.',1)
14: source+='\n'+(root/'notes/part3_flop_cobordism.md').read_text().replace('# P3K.17.','## P3K.17.',1)
15: caps=(root/'notes/part3_cap_restrictions.md').read_text()
16: source+='\n'+caps[caps.index('## P3K.18.'): ]
17: source+='\n'+(root/'notes/part3_whole_zero.md').read_text()
18: source+='\n'+(root/'notes/part3_source_reduction.md').read_text()
19: source+='\n'+(root/'notes/part3_primitive_sources.md').read_text()
20: source+='\n'+(root/'notes/part3_fixed_edge_flop.md').read_text()
21: parts=re.split(r'^## (P3K\.(?:[1-9]|1[0-9]|2[0-3]))\. Proved: (.+)\n',source,flags=re.M)
22: assert len(parts)==70
23: pieces=[r'\section{The local obstruction and the real trace of the actual return}'+'\n']
24: def markdown_table(match):
25:     rows=[line.strip().strip('|').split('|') for line in match.group(0).strip().splitlines()]
26:     rows=[row for row in rows if not all(set(c.strip()) <= set('-: ') for c in row)]
27:     def cell(c):
28:         c=c.strip()
29:         return r'\('+c.replace('−','-')+r'\)' if re.fullmatch('[−-][0-9]+',c) else c
30:     body=[' & '.join(cell(c) for c in row)+r' \\' for row in rows]
31:     spec='c p{0.48\\textwidth} c c c' if len(rows[0])==5 else 'c l l'
32:     return '\n'+r'\begin{center}\small\begin{tabular}{'+spec+r'}\hline'+'\n'+body[0]+'\n'+r'\hline'+'\n'+'\n'.join(body[1:])+'\n'+r'\hline\end{tabular}\end{center}'+'\n'
33: 
34: def tex(s):
35:     s=re.sub(r'(?m)^\|[^\n]+\|\n(?:\|[^\n]+\|\n)+',markdown_table,s)
36:     s=s.replace('**End of proof.**','')
37:     s=re.sub(r'\*\*Proof: (.*?)\.\*\*',lambda m:r'\par\medskip\noindent\textbf{'+m.group(1).capitalize()+r'.}\enspace',s)
38:     s=s.replace('**Proof.**','')
39:     s=re.sub(r'\*\*(.*?)\*\*',lambda m:r'\textbf{'+m.group(1)+'}',s)
40:     s=re.sub(r'`([^`]+)`',lambda m:r'\path{'+m.group(1)+'}',s)
41:     s=re.sub(r'^#{1,2} (.+)$',lambda m:r'\subsection{'+m.group(1)+'}',s,flags=re.M)
42:     return s.strip()+'\n'
43: for k in range(1,len(parts),3):
44:     ident,title,body=parts[k:k+3]
45:     after=''
46:     if ident in {'P3K.1','P3K.2','P3K.3','P3K.4'}:
47:         statement,proof=body.split('**Proof.**',1)
48:         proof,after=proof.split('**End of proof.**',1)
49:     elif ident=='P3K.5':
50:         statement=(r'The integral connecting class from the marked boundary '
51:             r'\(T^3\) has square zero and pairs trivially with every extension '
52:             r'of the page line.  In particular an odd cap correction does not '
53:             r'change the normal Euler square.')
54:         proof=body
55:     elif ident=='P3K.6':
56:         marker='**Proof: the actual orbit trivialization.**'
57:         statement,proof=body.split(marker,1)
58:         proof=marker+proof
59:     elif ident=='P3K.7':
60:         statement=(r'The real trace gives a spin bordism carrying the Euler '
61:             r'line from the actual covered conifold return to a normal sphere '
62:             r'bundle.  Its index is zero.  The original return also has index '
63:             r'zero, and its actual Hopf-lift gluing is the standard sphere.')
64:         proof=body
65:     elif ident=='P3K.8':
66:         statement=(r'The same actual return index vanishes by a second '
67:             r'calculation: vertical sphere quantization, an explicit marked '
68:             r'cap switch, and acyclicity of the elliptic Picard line.  This '
69:             r'calculation does not evaluate the page signature, its line '
70:             r'square, or its first Pontryagin number.')
71:         proof=body
72:     elif ident=='P3K.9':
73:         marker='**Proof: frames on the two pieces.**'
74:         statement,proof=body.split(marker,1)
75:         proof=marker+proof
76:     elif ident=='P3K.10':
77:         marker='**Proof: the source and its section.**'
78:         statement,proof=body.split(marker,1)
79:         proof=marker+proof
80:     elif ident=='P3K.11':
81:         marker='**Proof: the integral orbifold complex.**'
82:         statement,proof=body.split(marker,1)
83:         proof=marker+proof
84:     elif ident=='P3K.15':
85:         marker='**Proof: semifreeness from the actual fixed sphere.**'
86:         statement,proof=body.split(marker,1)
87:         proof,after=proof.split('**End of proof.**',1)
88:         proof=marker+proof
89:     elif ident=='P3K.16':
90:         marker='**Proof: construction of the map.**'
91:         statement,proof=body.split(marker,1)
92:         proof,after=proof.split('**End of proof.**',1)
93:         proof=marker+proof
94:     elif ident=='P3K.17':
95:         marker='**Proof: the real master space and its actual resolution maps.**'
96:         statement,proof=body.split(marker,1)
97:         proof,after=proof.split('**End of proof.**',1)
98:         proof=marker+proof
99:     elif ident=='P3K.19':
100:         marker='**Proof: the actual component maps and their multiplicities.**'
101:         statement,proof=body.split(marker,1)
102:         proof,after=proof.split('**End of proof.**',1)
103:         proof=marker+proof
104:     elif ident=='P3K.22':
105:         marker='**Proof: the source automorphisms and the line lift.**'
106:         statement,proof=body.split(marker,1)
107:         proof,after=proof.split('**End of proof.**',1)
108:         proof=marker+proof
109:     elif ident=='P3K.23':
110:         marker='**Proof: the actual two local products and the parameter clutch.**'
111:         statement,proof=body.split(marker,1)
112:         proof,after=proof.split('**End of proof.**',1)
113:         proof=marker+proof
114:     elif ident in {'P3K.20','P3K.21'}:
115:         marker={'P3K.20':'**Proof: the actual line-frame determinant.**',
116:                 'P3K.21':'**Proof: the marked quadratic root.**'}[ident]
117:         statement,proof=body.split(marker,1)
118:         proof,after=proof.split('**End of proof.**',1)
119:         proof=marker+proof
120:     else:
121:         statement,proof=body.split('**Proof.**',1)
122:         proof,after=proof.split('**End of proof.**',1)
123:     pieces.append('\\begin{statement}{'+ident+'}{Proved}\n'+tex(statement)+'\\end{statement}\n')
124:     pieces.append('\\begin{proof}\n'+tex(proof)+'\\end{proof}\n')
125:     if after.strip():
126:         pieces.append(tex(after))
127: (root/'notes/part3_fourfold.tex').write_text('\n'.join(pieces))
128: print('Exported P3K.1--23 in full to notes/part3_fourfold.tex')
