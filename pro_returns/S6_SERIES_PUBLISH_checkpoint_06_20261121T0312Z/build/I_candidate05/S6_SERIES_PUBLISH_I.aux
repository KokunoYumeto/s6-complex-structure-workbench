\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The fixed $(3,4,\infty )$ base data. The arrows denote the restriction of $f$ to each indicated fibre, with its scheme multiplicity retained. The ordinary period quotient, finite affine quotients and the paired hexagon are the three actual local models in the common conventions; their overlap maps are fixed there.}}{83}{figure.2}\protected@file@percent }
\newlabel{fig:I:orbifold}{{2}{83}{The fixed $(3,4,\infty )$ base data. The arrows denote the restriction of $f$ to each indicated fibre, with its scheme multiplicity retained. The ordinary period quotient, finite affine quotients and the paired hexagon are the three actual local models in the common conventions; their overlap maps are fixed there}{figure.2}{}}
\newlabel{fig:I:orbifold@cref}{{[figure][2][]2}{[1][82][]83}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The exact parameter disc for the standard fixed data. The coordinate map is $w=e^{-\pi i c}$ and the coarser coordinate map is $u=w^2$. The imaginary diameter is the fixed locus of $w\DOTSB \mapstochar \rightarrow -\bar  w$, which is the reflected-family map. The two boundary obstructions use the meridian comparison at the puncture and the intrinsic Albanese nome at the outer circle. The special fibres are over $t=0,1,\infty $ in every member, as indicated in Figure~\ref {fig:I:orbifold}.}}{83}{figure.3}\protected@file@percent }
\newlabel{fig:I:parameter-disc}{{3}{83}{The exact parameter disc for the standard fixed data. The coordinate map is $w=e^{-\pi i c}$ and the coarser coordinate map is $u=w^2$. The imaginary diameter is the fixed locus of $w\mapsto -\bar w$, which is the reflected-family map. The two boundary obstructions use the meridian comparison at the puncture and the intrinsic Albanese nome at the outer circle. The special fibres are over $t=0,1,\infty $ in every member, as indicated in Figure~\ref {fig:I:orbifold}}{figure.3}{}}
\newlabel{fig:I:parameter-disc@cref}{{[figure][3][]3}{[1][83][]83}{}{}{}}
