{
  "PJP_transpose": "Matrix([[0, 0], [0, 0]])",
  "real_evaluation_matrix": "Matrix([[1, 0, x, -y], [0, 1, y, x], [-x, -y, 1, 0], [-y, x, 0, -1]])",
  "real_determinant": "-(x**2 + y**2 + 1)**2",
  "complex_minors": {
    "(0, 1)": "2*I*z",
    "(0, 2)": "z**2 + 1",
    "(0, 3)": "I*(z - 1)*(z + 1)",
    "(1, 2)": "-I*(z - 1)*(z + 1)",
    "(1, 3)": "z**2 + 1",
    "(2, 3)": "-2*I*z"
  },
  "rank_at_infinity": 2,
  "coherent_quotient": "[v] -> P J v gives O(1)^2"
}
