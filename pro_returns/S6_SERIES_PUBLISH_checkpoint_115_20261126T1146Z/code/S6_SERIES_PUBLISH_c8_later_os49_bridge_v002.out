G_INVERSE=G; EXACT_FINITE_CONJUGACIES; VECTOR= [-n, n, n, d]
YANG_AFFINE_LAWS 1 ((tau - 1)/tau, -mu/tau + 1, beta - 3*mu**2/tau + 1) ALL_EIGHT_ENTRIES_MATCH
YANG_AFFINE_LAWS 2 (-1/(tau + 1), mu/(tau + 1), beta - 3*mu**2/(tau + 1)) ALL_EIGHT_ENTRIES_MATCH
FINITE_FIXED_VALUE_ERROR= -(tau**2 - tau + 1)/(3*tau) VANISHES_AT_tau^2-tau+1=0
PARAMETER_MAP (n_Y,r)=(-n_P,d_P); INVERSE_IDENTICAL
CLOCKWISE_NORMAL_VALUES= [-n, -3*d, 3*k]
EXACT_TRANSFER_u2_p_q= [3*d, -n, 0] [3*k, 0, n] [0, k, d]
REFERENCE_CAP u2+q HORIZONTAL; -psi HAS NORMAL_VALUE_ONE
TRANSFER_CROSS_PRODUCT= [-n**2, -3*d*n, 3*k*n]
POSITIVE_NORMAL=-CLOCKWISE_NORMAL; THOM_GENERATOR_MAP=-1; LAST_PAIR_ARROW=-n
GEOMETRIC_ROOF_AND_CHART_PROOF_IS_IN_THE_WRITTEN_COMPARISON; NO_SAMPLED_GEOMETRY_CREDIT
