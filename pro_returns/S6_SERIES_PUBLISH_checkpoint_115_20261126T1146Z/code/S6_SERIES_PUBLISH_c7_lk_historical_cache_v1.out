def group(M):
    D=smith_normal_form(M,domain=s.ZZ)
    v=[abs(int(D[i,i])) for i in range(min(D.shape)) if D[i,i]]
    return dict(free=M.rows-len(v),torsion=[z for z in v if z>1])
